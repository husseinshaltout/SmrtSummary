{
  "name": "smrtsummary_resources",
  "version": "1.0.0",
  "description": "smrtsummary tailwind style",
  "scripts": {
    "build-css": "tailwindcss -i SmrtSummary/static/src/input.css -o SmrtSummary/static/css/output.css",
    "build-css:watch": "tailwindcss -i SmrtSummary/static/src/input.css -o SmrtSummary/static/css/output.css --watch",
    "build-frontend": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "eslint": "^8.16.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.26.0",
    "tailwindcss": "^3.4.13"
  }
}
